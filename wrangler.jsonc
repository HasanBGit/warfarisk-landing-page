{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warfarisk",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "warfarisk.com", "custom_domain": true },
    { "pattern": "www.warfarisk.com", "custom_domain": true }
  ]
}
