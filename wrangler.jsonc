{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warfarisk",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the home page and the team pages go through the Worker. Images, scripts and styles are served straight from the files.
    "run_worker_first": ["/", "/faq/", "/team/*/"]
  },
  "routes": [
    { "pattern": "warfarisk.com", "custom_domain": true },
    { "pattern": "www.warfarisk.com", "custom_domain": true }
  ]
}
